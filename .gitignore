.claude/settings.local.json

# OpenCode generated files (reinstallable)
opencode/node_modules/
opencode/package.json
opencode/bun.lock

# Proxy runtime files (contain API key, pid, logs)
proxy/run/

# Runtime artifacts and logs
.confluence_progress.json
confluence_export.log
*.swp

# External dependencies (not managed by this repo)
externals/

# Nested standalone skill repos — managed separately
opencode/skills/xpm-seq/
claude/skills/ask-tiled/
claude/skills/ask-s3df/
claude/skills/ask-epics/
claude/skills/ask-nersc/
claude/skills/ask-olcf/

# Shared Claude Code binary — published by tools/claude-binary, never committed.
# This repo has never carried binaries and must not start: a 330 MB blob in git
# history is permanent. Every published version is reproducible from its version
# number and SHA-256 in the deployed claude/bin/VERSIONS.json.
claude/bin/
