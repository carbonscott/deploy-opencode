#!/usr/bin/env bash
# Launch OpenCode inside an Apptainer security sandbox.
#
# Usage:
#   opencode-sandbox [OPTIONS] [-- OPENCODE_ARGS...]
#
# Options:
#   --no-sandbox    Bypass the sandbox (run OpenCode directly)
#   --data PATH     Add an extra read-only bind mount (repeatable)
#   --rw PATH       Add an extra read-write bind mount (repeatable)
#   --incognito     Ephemeral session — scratch state deleted on exit
#   --dry-run       Print the apptainer command without executing
#   --help          Show this help message
#
# Environment variables:
#   OPENCODE_SANDBOX_SIF    Path to SIF (default: alongside this script)
#   OPENCODE_SANDBOX_EXTRA  Colon-separated extra read-only bind paths
#   OPENCODE_SANDBOX_GH=0   Do not copy your GitHub CLI (gh) login in
#   OPENCODE_SANDBOX_HUNK=0 Do not let the agent reach the Hunk viewer you open
#   OPENCODE_SANDBOX_VERSION=X  Run installed opencode X (e.g. 1.2.10), not the current one

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SIF="${OPENCODE_SANDBOX_SIF:-${SCRIPT_DIR}/opencode-sandbox.sif}"

# --- Parse arguments ---
NO_SANDBOX=false
DRY_RUN=false
INCOGNITO=false
EXTRA_RO_BINDS=()
EXTRA_RW_BINDS=()
OPENCODE_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-sandbox)
            NO_SANDBOX=true
            shift
            ;;
        --data)
            [[ $# -lt 2 ]] && echo "Error: --data requires a path" >&2 && exit 1
            EXTRA_RO_BINDS+=("$2")
            shift 2
            ;;
        --rw)
            [[ $# -lt 2 ]] && echo "Error: --rw requires a path" >&2 && exit 1
            EXTRA_RW_BINDS+=("$2")
            shift 2
            ;;
        --incognito)
            INCOGNITO=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --help)
            head -24 "$0" | grep '^#' | sed 's/^# \?//'
            exit 0
            ;;
        --)
            shift
            OPENCODE_ARGS+=("$@")
            break
            ;;
        *)
            OPENCODE_ARGS+=("$1")
            shift
            ;;
    esac
done

# Parse OPENCODE_SANDBOX_EXTRA env var
if [[ -n "${OPENCODE_SANDBOX_EXTRA:-}" ]]; then
    IFS=':' read -ra _extra <<< "$OPENCODE_SANDBOX_EXTRA"
    EXTRA_RO_BINDS+=("${_extra[@]}")
fi

# --- OpenCode config (always use the shared config) ---
OPENCODE_CONFIG_DIR="/sdf/group/lcls/ds/dm/apps/dev/opencode"

# --- Resolve opencode binary by absolute path ---
# Don't rely on the user's PATH or shell function (see docs/setup.md): regular
# users invoke opencode through a shell wrapper that prepends the bin dir only
# for its own call, so a bare `exec opencode` fails with "opencode: not found".
# Resolving the absolute path makes both execution paths work for everyone.
#
# Versions live in opencode-cli/<ver>/bin, installed by
# tools/opencode/install-opencode.sh; `current` names the one everybody runs.
# Read the link ONCE here, so a session keeps one version even if `current`
# moves while it runs (the agent's own `opencode` calls included).
# OPENCODE_SANDBOX_VERSION picks another installed version: for trying a new
# one before --activate, or for one person to step back without moving anyone.
OPENCODE_CLI_HOME="/sdf/group/lcls/ds/dm/apps/dev/opencode-cli"
OPENCODE_VERSION="${OPENCODE_SANDBOX_VERSION:-$(readlink "${OPENCODE_CLI_HOME}/current" 2>/dev/null || true)}"
if [[ ! "$OPENCODE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    if [[ -n "${OPENCODE_SANDBOX_VERSION:-}" ]]; then
        echo "Error: OPENCODE_SANDBOX_VERSION must look like 1.19.5 (got '${OPENCODE_SANDBOX_VERSION}')" >&2
    else
        echo "Error: cannot read the current opencode version from ${OPENCODE_CLI_HOME}/current" >&2
    fi
    exit 1
fi
OPENCODE_BIN_DIR="${OPENCODE_CLI_HOME}/${OPENCODE_VERSION}/bin"
OPENCODE_BIN="${OPENCODE_BIN_DIR}/opencode"
if [[ ! -x "$OPENCODE_BIN" ]]; then
    echo "Error: opencode ${OPENCODE_VERSION} is not installed ($OPENCODE_BIN)" >&2
    echo "Installed: $(cd "$OPENCODE_CLI_HOME" 2>/dev/null && ls -d [0-9]* 2>/dev/null | tr '\n' ' ')" >&2
    exit 1
fi
if [[ -n "${OPENCODE_SANDBOX_VERSION:-}" ]]; then
    echo "[sandbox] Running opencode ${OPENCODE_VERSION} (OPENCODE_SANDBOX_VERSION), not the current one" >&2
fi

# --- Shared environment (single source of truth for BOTH execution paths) ---
# The sandbox path turns these into apptainer --env flags; the --no-sandbox
# path hands them straight to `env`. Keep them here so the two can't drift.
OPENCODE_ENV=(
    "USER=${USER}"
    "OPENCODE_CONFIG_DIR=${OPENCODE_CONFIG_DIR}"
    "UV_CACHE_DIR=/tmp/uv-cache-${USER}"
    "UV_PYTHON_INSTALL_DIR=/sdf/group/lcls/ds/dm/apps/dev/python"
    # The shared binary is upgraded centrally (install-opencode.sh), so hide
    # opencode's "/update to upgrade" prompt; /update cannot work here anyway.
    "OPENCODE_DISABLE_AUTOUPDATE=1"
    "TERM=${TERM:-xterm-256color}"
    "LANG=${LANG:-en_US.UTF-8}"
    "PATH=${OPENCODE_BIN_DIR}:/sdf/group/lcls/ds/dm/apps/dev/bin:${PATH}"
)

# --- No-sandbox escape hatch ---
OPENCODE_MAJOR="${OPENCODE_VERSION%%.*}"
if $NO_SANDBOX; then
    # opencode 2.x treats OPENCODE_CONFIG_DIR as the user's own, writable config
    # folder and writes service.json (its server password) and cli.json there.
    # Pointed at the shared folder it fails for users, and for the folder's
    # owner it would leave a password file that all of ps-users can read. The
    # sandbox path below gives 2.x a per-user folder instead.
    if (( OPENCODE_MAJOR >= 2 )); then
        echo "Error: --no-sandbox runs opencode 1.x only; opencode ${OPENCODE_VERSION} needs the sandbox." >&2
        echo "       Pick a 1.x version with OPENCODE_SANDBOX_VERSION, or drop --no-sandbox." >&2
        exit 1
    fi
    echo "[sandbox] Bypassing sandbox — running OpenCode directly (shared config)." >&2
    exec env "${OPENCODE_ENV[@]}" "$OPENCODE_BIN" "${OPENCODE_ARGS[@]}"
fi

# --- Validate SIF ---
if [[ ! -f "$SIF" ]]; then
    echo "Error: SIF not found: $SIF" >&2
    echo "Run build.sh or set OPENCODE_SANDBOX_SIF." >&2
    exit 1
fi

# --- Set up scratch directories ---
SCRATCH_ROOT="${SCRATCH:-/tmp}"
if $INCOGNITO; then
    SCRATCH_BASE="$(mktemp -d "${SCRATCH_ROOT}/${USER}-opencode-sandbox-XXXXXX")"
    trap 'rm -rf "$SCRATCH_BASE"' EXIT
    echo "[sandbox] Incognito mode — session state will be deleted on exit" >&2
else
    SCRATCH_BASE="${SCRATCH_ROOT}/${USER}-opencode-sandbox"
fi
SCRATCH_HOME="${SCRATCH_BASE}/home"
SCRATCH_TMP="${SCRATCH_BASE}/tmp"
mkdir -p "$SCRATCH_HOME" "$SCRATCH_TMP"
# The sandbox home holds per-user secrets (see the Confluence token below) and
# SCRATCH defaults to /tmp on a shared node, so keep it owner-only.
chmod 700 "$SCRATCH_BASE" "$SCRATCH_HOME"

# --- opencode 2.x: per-user config folder, private server, own history ---
# 2.x differs from 1.x in three ways that matter on a shared node:
#  - It treats OPENCODE_CONFIG_DIR as the user's own config folder and writes
#    to it (service.json, cli.json), so it cannot point at the read-only
#    shared folder. Instead each user gets a folder in the sandbox home made of
#    links to the shared opencode.json, agents/, commands/ and skills/, plus
#    the 2.x-only settings in the shared v2/opencode.jsonc. The 1.x plugin/
#    folder is NOT linked: 1.x plugins do not load in 2.x.
#  - By default it runs one background server per user on a fixed port
#    (49374), which a second user on the same node cannot bind.
#    service.json {"disabled": true} makes every session start a private
#    server on a random port that exits with the session ("standalone").
#  - Its first start copies 1.x sessions into new tables once; after that the
#    two versions no longer see each other's work. So 2.x gets its own
#    database, seeded once from a copy of the 1.x one, and going back to 1.x
#    loses nothing.
set_opencode_env() {
    local i
    for i in "${!OPENCODE_ENV[@]}"; do
        if [[ "${OPENCODE_ENV[$i]}" == "$1="* ]]; then OPENCODE_ENV[$i]="$1=$2"; return; fi
    done
    OPENCODE_ENV+=("$1=$2")
}
if (( OPENCODE_MAJOR >= 2 )); then
    V2_CONFIG_DIR="${SCRATCH_HOME}/.config/opencode-lcls-v2"
    mkdir -p "$V2_CONFIG_DIR"
    v2_link() {  # v2_link <target> <name>: (re)point a link, never touch a real file
        local dst="${V2_CONFIG_DIR}/$2"
        if [[ -e "$dst" && ! -L "$dst" ]]; then
            echo "[sandbox] Warning: ${dst} is not a link; leaving it alone" >&2
            return 0
        fi
        ln -sfn "$1" "$dst"
    }
    for name in opencode.json agents commands skills; do
        v2_link "${OPENCODE_CONFIG_DIR}/${name}" "$name"
    done
    if [[ -f "${OPENCODE_CONFIG_DIR}/v2/opencode.jsonc" ]]; then
        v2_link "${OPENCODE_CONFIG_DIR}/v2/opencode.jsonc" opencode.jsonc
    fi
    if [[ -d "${OPENCODE_CONFIG_DIR}/v2/plugins" ]]; then
        v2_link "${OPENCODE_CONFIG_DIR}/v2/plugins" plugins
    fi
    printf '{"disabled": true}\n' > "${V2_CONFIG_DIR}/service.json"

    V1_DB="${SCRATCH_HOME}/.local/share/opencode/opencode.db"
    V2_DB="${SCRATCH_HOME}/.local/share/opencode/opencode-v2.db"
    if [[ ! -e "$V2_DB" && -f "$V1_DB" ]]; then
        mkdir -p "$(dirname "$V2_DB")"
        # sqlite3's .backup takes a consistent copy even if a 1.x session is open.
        if command -v sqlite3 >/dev/null && sqlite3 "$V1_DB" ".backup '${V2_DB}'"; then
            echo "[sandbox] Copied your 1.x session history into opencode ${OPENCODE_MAJOR}.x's own history (one time)" >&2
        else
            rm -f "$V2_DB"
            echo "[sandbox] Warning: could not copy your 1.x history; opencode ${OPENCODE_VERSION} starts with an empty one" >&2
        fi
    fi
    set_opencode_env OPENCODE_CONFIG_DIR "$V2_CONFIG_DIR"
    set_opencode_env OPENCODE_DB "$V2_DB"
fi

# --- Copy git config so commits have correct author ---
if [[ -f "${HOME}/.gitconfig" ]]; then
    cp "${HOME}/.gitconfig" "${SCRATCH_HOME}/.gitconfig" 2>/dev/null || true
fi

# --- Copy the Confluence token into the sandbox home ---
# The confluence-search skill resolves its token from the passwd database
# (pwd.getpwuid().pw_dir), not $HOME, so apptainer's --home override does not
# redirect it: it looks under /sdf/home, which the sandbox deliberately does not
# bind. Copy the token in and point CONFLUENCE_TOKEN_FILE at the copy — the
# skill checks that variable before it consults passwd.
HOST_CONFLUENCE_TOKEN="${HOME}/.config/confluence-search/token"
SANDBOX_CONFLUENCE_TOKEN="${SCRATCH_HOME}/.config/confluence-search/token"
if [[ -f "$HOST_CONFLUENCE_TOKEN" ]]; then
    mkdir -p "$(dirname "$SANDBOX_CONFLUENCE_TOKEN")"
    chmod 700 "$(dirname "$SANDBOX_CONFLUENCE_TOKEN")"
    # The skill refuses any token file readable by group or others, so do not
    # let the ambient umask decide the mode.
    if install -m 600 "$HOST_CONFLUENCE_TOKEN" "$SANDBOX_CONFLUENCE_TOKEN" 2>/dev/null; then
        OPENCODE_ENV+=("CONFLUENCE_TOKEN_FILE=${SANDBOX_CONFLUENCE_TOKEN}")
    else
        echo "[sandbox] Warning: could not copy Confluence token; confluence-search will not authenticate" >&2
    fi
fi

# --- Copy the Jira token into the sandbox home ---
# Same story as the Confluence token above: jira-search resolves its default
# token path from the passwd database, which points at /sdf/home — not bound
# here — so the copy plus JIRA_TOKEN_FILE is what makes it resolvable. Kept as
# a separate block rather than folded into a loop so each skill's failure
# message names the skill that will stop working.
HOST_JIRA_TOKEN="${HOME}/.config/jira-search/token"
SANDBOX_JIRA_TOKEN="${SCRATCH_HOME}/.config/jira-search/token"
if [[ -f "$HOST_JIRA_TOKEN" ]]; then
    mkdir -p "$(dirname "$SANDBOX_JIRA_TOKEN")"
    chmod 700 "$(dirname "$SANDBOX_JIRA_TOKEN")"
    # jqlsearch.py refuses any token file with group or other bits set, so do
    # not let the ambient umask decide the mode.
    if install -m 600 "$HOST_JIRA_TOKEN" "$SANDBOX_JIRA_TOKEN" 2>/dev/null; then
        OPENCODE_ENV+=("JIRA_TOKEN_FILE=${SANDBOX_JIRA_TOKEN}")
    else
        echo "[sandbox] Warning: could not copy Jira token; jira-search will not authenticate" >&2
    fi
fi

# --- Copy the GitHub CLI login into the sandbox home ---
# gh-skills drives the shared gh (dev/bin/gh, on PATH below). gh keeps its login
# in ~/.config/gh/hosts.yml under the real $HOME, which the sandbox hides, so copy
# hosts.yml (and config.yml) in and point GH_CONFIG_DIR at the copy. This hands
# the agent the GitHub access that login has: a default `gh auth login` token
# can write to every repo the account reaches. The launch banner says so, and
# OPENCODE_SANDBOX_GH=0 skips the copy. Any earlier copy is removed first, so an
# opt-out or a host-side `gh auth logout` takes effect on the next launch. Log in
# OUTSIDE the sandbox: a login made inside is overwritten on the next launch.
HOST_GH_DIR="${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/gh}"
SANDBOX_GH_DIR="${SCRATCH_HOME}/.config/gh"
GH_LOGIN_COPIED=false
rm -f "${SANDBOX_GH_DIR}/hosts.yml" "${SANDBOX_GH_DIR}/config.yml"
if [[ "${OPENCODE_SANDBOX_GH:-1}" != "0" && -f "${HOST_GH_DIR}/hosts.yml" ]]; then
    mkdir -p "$SANDBOX_GH_DIR"
    chmod 700 "$SANDBOX_GH_DIR"
    if install -m 600 "${HOST_GH_DIR}/hosts.yml" "${SANDBOX_GH_DIR}/hosts.yml" 2>/dev/null; then
        if [[ -f "${HOST_GH_DIR}/config.yml" ]]; then
            install -m 600 "${HOST_GH_DIR}/config.yml" "${SANDBOX_GH_DIR}/config.yml" 2>/dev/null || true
        fi
        OPENCODE_ENV+=("GH_CONFIG_DIR=${SANDBOX_GH_DIR}")
        GH_LOGIN_COPIED=true
    else
        echo "[sandbox] Warning: could not copy GitHub CLI login; gh will not be authenticated" >&2
    fi
fi

# --- Build bind mount list ---
BINDS=()

# System tools (read-only) — host paths preserved inside container
BINDS+=("--bind" "/usr:/usr:ro")
BINDS+=("--bind" "/lib64:/lib64:ro")
BINDS+=("--bind" "/bin:/bin:ro")
BINDS+=("--bind" "/sbin:/sbin:ro")

# Shared deployment directory (read-only).
# The opencode API keys (dev/env/key.dat, dev/env/slac-key.dat — referenced by
# the shared opencode.json) come in via this bind; no separate key bind needed.
BINDS+=("--bind" "/sdf/group/lcls/ds/dm/apps/dev:/sdf/group/lcls/ds/dm/apps/dev:ro")

# Science data (read-only)
if [[ -d /sdf/data/lcls ]]; then
    BINDS+=("--bind" "/sdf/data/lcls:/sdf/data/lcls:ro")
fi

# --- S3DF OAuth2 token for elog-search (read-only bind) ---
# A bind, not a copy like the Confluence token above, for two reasons: it keeps a
# second copy of the refresh token off scratch, and `s3df login` refreshes by
# truncating these files in place, so the container sees a renewed token without
# a restart. S3DF_TOKEN_FILE/S3DF_TOKEN_META are the names s3df-login itself
# documents and elog-search honours, so naming them here means no home-resolution
# is involved at all.
# Kerberos is deliberately NOT forwarded: a TGT is delegatable, and /usr is bound
# so ssh exists here — forwarding one would re-enable the SSH this sandbox disables.
if [[ -f "${HOME}/.s3df-access-token" ]]; then
    BINDS+=("--bind" "${HOME}/.s3df-access-token:${HOME}/.s3df-access-token:ro")
    OPENCODE_ENV+=("S3DF_TOKEN_FILE=${HOME}/.s3df-access-token")
    if [[ -f "${HOME}/.s3df-token.json" ]]; then
        BINDS+=("--bind" "${HOME}/.s3df-token.json:${HOME}/.s3df-token.json:ro")
        OPENCODE_ENV+=("S3DF_TOKEN_META=${HOME}/.s3df-token.json")
    fi
fi

# --- Hunk session keys (read-only bind) ---
# hunk-review drives a Hunk viewer the user opens in their own terminal, outside
# the sandbox, through a daemon on 127.0.0.1 (the network is shared, so it is
# reachable from here). Every request is signed with per-user keys kept in
# $XDG_RUNTIME_DIR/hunk-mcp, which --containall hides; without them the CLI in
# here mints its own keys and the daemon refuses it. So bind that ONE directory
# at its own path, never all of /run/user/<uid>, which also holds other agents'
# sockets. Read-only on purpose: the unsandboxed viewer writes lock and metadata
# files there, and a writable bind would let the agent plant symlinks for it to
# follow (the sandbox's separate PID namespace would also make the host daemon
# look dead and get its metadata deleted). Create it first, so a viewer opened
# after launch is still reachable. The shared hunk wrapper derives the port from
# the uid, which is the same in here; a HUNK_MCP_PORT set by hand is forwarded.
# With this, the agent can read and annotate whatever you open in Hunk on this
# node, and reload it within that repo. OPENCODE_SANDBOX_HUNK=0 skips it.
HUNK_KEYS_BOUND=false
HUNK_KEYS_EXIST=false
if [[ "${OPENCODE_SANDBOX_HUNK:-1}" != "0" && -n "${XDG_RUNTIME_DIR:-}" \
      && -d "$XDG_RUNTIME_DIR" && -O "$XDG_RUNTIME_DIR" ]]; then
    HUNK_RUNTIME="${XDG_RUNTIME_DIR}/hunk-mcp"
    [[ -e "$HUNK_RUNTIME" ]] || (umask 077 && mkdir "$HUNK_RUNTIME") 2>/dev/null || true
    if [[ -d "$HUNK_RUNTIME" && ! -L "$HUNK_RUNTIME" && -O "$HUNK_RUNTIME" ]]; then
        BINDS+=("--bind" "${HUNK_RUNTIME}:${HUNK_RUNTIME}:ro")
        OPENCODE_ENV+=("XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}")
        HUNK_KEYS_BOUND=true
        if [[ -d "${HUNK_RUNTIME}/security-v1" ]]; then HUNK_KEYS_EXIST=true; fi
    fi
fi
if [[ "${OPENCODE_SANDBOX_HUNK:-1}" != "0" && -n "${HUNK_MCP_PORT:-}" ]]; then
    OPENCODE_ENV+=("HUNK_MCP_PORT=${HUNK_MCP_PORT}")
fi

# Slurm (read-only) — /run/slurm/conf is a symlink to /var/spool/slurmd/conf-cache
for slurm_path in /opt/slurm /etc/slurm /run/slurm /var/spool/slurmd/conf-cache /run/munge /var/run/munge; do
    if [[ -e "$slurm_path" ]]; then
        BINDS+=("--bind" "${slurm_path}:${slurm_path}:ro")
    fi
done

# SSSD (read-only) — needed for user/group resolution via NSS
# S3DF uses SSSD/LDAP; without this, Slurm commands like "squeue -u $USER" fail
# with "Invalid user" because the username can't be resolved to a UID
if [[ -d /var/lib/sss ]]; then
    BINDS+=("--bind" "/var/lib/sss:/var/lib/sss:ro")
fi

# Slurm libraries and shared objects
if [[ -d /etc/ld.so.conf.d ]]; then
    BINDS+=("--bind" "/etc/ld.so.conf.d:/etc/ld.so.conf.d:ro")
fi
if [[ -f /etc/ld.so.cache ]]; then
    BINDS+=("--bind" "/etc/ld.so.cache:/etc/ld.so.cache:ro")
fi

# Kerberos/GSSAPI for elog (read-only)
if [[ -d /sdf/group/lcls/ds/ana/sw/conda1 ]]; then
    BINDS+=("--bind" "/sdf/group/lcls/ds/ana/sw/conda1:/sdf/group/lcls/ds/ana/sw/conda1:ro")
fi

# Network config (needed for Slurm, DNS)
for netfile in /etc/hosts /etc/resolv.conf /etc/nsswitch.conf /etc/passwd /etc/group; do
    if [[ -f "$netfile" ]]; then
        BINDS+=("--bind" "${netfile}:${netfile}:ro")
    fi
done

# Alternatives system (needed for symlinks like /usr/bin/nc → /etc/alternatives/nmap)
if [[ -d /etc/alternatives ]]; then
    BINDS+=("--bind" "/etc/alternatives:/etc/alternatives:ro")
fi

# Current working directory (read-write)
BINDS+=("--bind" "$(pwd):$(pwd):rw")

# Scratch tmp (read-write)
BINDS+=("--bind" "${SCRATCH_TMP}:/tmp:rw")

# User-specified extra read-only mounts
for path in "${EXTRA_RO_BINDS[@]}"; do
    if [[ -e "$path" ]]; then
        BINDS+=("--bind" "${path}:${path}:ro")
    else
        echo "[sandbox] Warning: --data path does not exist, skipping: $path" >&2
    fi
done

# User-specified extra read-write mounts
for path in "${EXTRA_RW_BINDS[@]}"; do
    if [[ -e "$path" ]]; then
        BINDS+=("--bind" "${path}:${path}:rw")
    else
        echo "[sandbox] Warning: --rw path does not exist, skipping: $path" >&2
    fi
done

# --- Build environment flags for apptainer (from the shared OPENCODE_ENV) ---
# Note: --containall blocks --env HOME=..., so we use --home instead
ENVS=()
for kv in "${OPENCODE_ENV[@]}"; do
    ENVS+=("--env" "$kv")
done

# --- Assemble the full command ---
APPTAINER_CMD=(
    apptainer run
    # Note: network is intentionally NOT isolated (no --net none)
    # because Slurm and DNS require network access.
    --containall
    --home "${SCRATCH_HOME}"
    --pwd "$(pwd)"
    "${BINDS[@]}"
    "${ENVS[@]}"
    "$SIF"
    opencode "${OPENCODE_ARGS[@]}"
)

# --- Execute ---
if $DRY_RUN; then
    echo "[sandbox] Would execute:"
    printf '  %s\n' "${APPTAINER_CMD[@]}"
    exit 0
fi

echo "[sandbox] Launching OpenCode in Apptainer sandbox ..." >&2
echo "[sandbox] Working directory: $(pwd)" >&2
echo "[sandbox] Home (sandboxed): ${SCRATCH_HOME}" >&2
echo "[sandbox] Real \$HOME is hidden — git push, SSH disabled (by design)" >&2
if $GH_LOGIN_COPIED; then
    echo "[sandbox] GitHub CLI login copied in: gh can act on GitHub as you (OPENCODE_SANDBOX_GH=0 to skip)" >&2
fi
if $HUNK_KEYS_BOUND && $HUNK_KEYS_EXIST; then
    echo "[sandbox] Hunk keys visible (read-only): the agent can read and annotate what you open in Hunk (OPENCODE_SANDBOX_HUNK=0 to skip)" >&2
fi
if $INCOGNITO; then
    "${APPTAINER_CMD[@]}"
else
    exec "${APPTAINER_CMD[@]}"
fi
