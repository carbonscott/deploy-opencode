{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "stanford": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Stanford AI Gateway",
      "options": {
        "baseURL": "https://aiapi-prod.stanford.edu/v1",
        "apiKey": "{file:/sdf/group/lcls/ds/dm/apps/dev/env/key.dat}"
      },
      "models": {
        "claude-4-5-sonnet": {
          "name": "Claude 4.5 Sonnet",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "cost": {
            "input": 3,
            "output": 15
          }
        },
        "claude-4-sonnet": {
          "name": "Claude 4 Sonnet",
          "cost": {
            "input": 3,
            "output": 15
          }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro"
        }
      }
    },
    "slac": {
      "npm": "@ai-sdk/anthropic",
      "name": "SLAC AI Gateway",
      "options": {
        "baseURL": "https://ai-api.slac.stanford.edu/v1",
        "apiKey": "{file:/sdf/group/lcls/ds/dm/apps/dev/env/slac-key.dat}"
      },
      "models": {
        "us.anthropic.claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "variants": {
            "medium": { "thinking": { "type": "enabled", "budgetTokens": 8000 } },
            "high":   { "thinking": { "type": "enabled", "budgetTokens": 16000 } },
            "max":    { "thinking": { "type": "enabled", "budgetTokens": 32000 } }
          },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "cost": { "input": 3, "output": 15 }
        },
        "us.anthropic.claude-opus-4-6-v1": {
          "name": "Claude Opus 4.6",
          "variants": {
            "medium": { "thinking": { "type": "enabled", "budgetTokens": 8000 } },
            "high":   { "thinking": { "type": "enabled", "budgetTokens": 16000 } },
            "max":    { "thinking": { "type": "enabled", "budgetTokens": 32000 } }
          },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "cost": { "input": 5, "output": 25 }
        },
        "us.anthropic.claude-haiku-4-5-20251001-v1:0": {
          "name": "Claude Haiku 4.5",
          "variants": {
            "medium": { "thinking": { "type": "enabled", "budgetTokens": 4000 } },
            "high":   { "thinking": { "type": "enabled", "budgetTokens": 8000 } },
            "max":    { "thinking": { "type": "enabled", "budgetTokens": 16000 } }
          },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "cost": { "input": 1, "output": 5 }
        },
        "us.anthropic.claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "limit": { "context": 1000000, "output": 128000 },
          "reasoning": true,
          "variants": {
            "low":    { "effort": "low" },
            "medium": { "effort": "medium" },
            "high":   { "effort": "high" },
            "max":    { "effort": "max" }
          },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "cost": { "input": 2, "output": 10, "cache_write": 2.50, "cache_read": 0.20 }
        },
        "us.anthropic.claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": { "context": 1000000, "output": 128000 },
          "reasoning": true,
          "variants": {
            "low":    { "effort": "low" },
            "medium": { "effort": "medium" },
            "high":   { "effort": "high" },
            "max":    { "effort": "max" }
          },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "cost": { "input": 5, "output": 25, "cache_write": 6.25, "cache_read": 0.50 }
        },
        "us.anthropic.claude-fable-5-1": {
          "name": "Claude Fable 5.1",
          "limit": { "context": 1000000, "output": 128000 },
          "reasoning": true,
          "variants": {
            "low":    { "effort": "low" },
            "medium": { "effort": "medium" },
            "high":   { "effort": "high" },
            "max":    { "effort": "max" }
          },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "cost": { "input": 10, "output": 50, "cache_write": 12.50, "cache_read": 0.25 }
        }
      }
    }
  },
  "model": "slac/us.anthropic.claude-sonnet-5",
  "small_model": "slac/us.anthropic.claude-haiku-4-5-20251001-v1:0",
  "agent": {
    "build":   { "variant": "medium" },
    "plan":    { "variant": "medium" },
    "general": { "variant": "medium" },
    "explore": { "variant": "medium" },
    "scout":   { "variant": "medium" },
    "coder":   { "variant": "medium" }
  },
  "tui": {
    "theme": "opencode"
  },
  "permission": {
    "external_directory": {
      "/sdf/group/lcls/ds/dm/apps/dev/software/**": "allow",
      "/sdf/group/lcls/ds/dm/apps/dev/tools/**": "allow",
      "/sdf/group/lcls/ds/dm/apps/dev/data/**": "allow",
      "/sdf/group/lcls/ds/dm/apps/dev/bin/**": "allow",
      "/tmp/**": "allow"
    },
    "edit": {
      "/sdf/group/lcls/ds/dm/apps/dev/software/**": "deny",
      "/sdf/group/lcls/ds/dm/apps/dev/tools/**": "deny",
      "/sdf/group/lcls/ds/dm/apps/dev/data/**": "deny",
      "/sdf/group/lcls/ds/dm/apps/dev/bin/**": "deny",
      "/tmp/**": "deny"
    }
  }
}
